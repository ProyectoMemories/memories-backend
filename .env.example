# ═══════════════════════════════════════════════════════════════════════
# Memories — variables de entorno para desarrollo local
# Copia este archivo a .env y cambia las contraseñas. El .env NUNCA se sube.
# ═══════════════════════════════════════════════════════════════════════

# ─── API ────────────────────────────────────────────────────────────────
# Puerto de la API en tu PC: http://localhost:8001
API_HOST_PORT=8001
# Único origen al que CORS deja llamar a la API: el de la app web. Corre
# Flutter web en este puerto: flutter run -d chrome --web-port 3000
# Sin '/' al final y nunca '*'.
WEB_APP_ORIGIN=http://localhost:3000
# Firma los tokens de sesión y de los enlaces de los correos. Mínimo 32
# caracteres. Para generar una propia en PowerShell:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Nunca uses la misma en producción.
SECRET_KEY=cambiame-por-una-clave-larga-y-aleatoria-de-al-menos-32
# Versión vigente de la política de privacidad; se guarda al registrarse (RN-50).
PRIVACY_POLICY_VERSION=2026-11-borrador
# Remitente de los correos (en local los captura Mailpit, ver más abajo).
EMAIL_FROM="Memories <no-reply@memories.local>"

# Base de datos para la API y Alembic cuando corren FUERA de Docker (dentro de
# Docker, docker-compose.yml arma la URL con los valores de PostgreSQL).
# Usuario, clave, puerto y base deben coincidir con la sección de PostgreSQL.
DATABASE_URL=postgresql+psycopg://memories:cambiame@localhost:5433/memories
# Base de las pruebas: debe terminar en _test; pytest la borra y la crea de
# nuevo en cada corrida.
TEST_DATABASE_URL=postgresql+psycopg://memories:cambiame@localhost:5433/memories_test

# ─── PostgreSQL 18 ──────────────────────────────────────────────────────
POSTGRES_USER=memories
POSTGRES_PASSWORD=cambiame
POSTGRES_DB=memories
# Puerto en tu PC. 5433 para no chocar con otro PostgreSQL que ya tengas.
POSTGRES_HOST_PORT=5433

# ─── MinIO (almacenamiento S3 de las fotos) ─────────────────────────────
# Usuario de al menos 3 caracteres y contraseña de al menos 8.
# Solo letras y números: van dentro de una URL en docker-compose.yml.
MINIO_ROOT_USER=memories
MINIO_ROOT_PASSWORD=cambiame123
S3_BUCKET=memories-photos
# API S3 y consola web en tu PC.
MINIO_API_HOST_PORT=9010
MINIO_CONSOLE_HOST_PORT=9011

# ─── Mailpit (correos de desarrollo) ────────────────────────────────────
# Captura todos los correos que envía la API; se ven en http://localhost:8025.
# Dentro de Docker la API usa mailpit:1025. Fuera de Docker, usa estos:
SMTP_HOST=localhost
SMTP_PORT=1025
MAILPIT_SMTP_HOST_PORT=1025
MAILPIT_UI_HOST_PORT=8025
