# ════════════════════════════════════════════════════════════════════
# Memories API — variables de entorno
# Copia este archivo a .env y ajusta los valores. NUNCA subas el .env.
# ════════════════════════════════════════════════════════════════════

# ─── Aplicacion ─────────────────────────────────────────────────────
ENV=development
DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=console
# La documentacion (/docs, /redoc, /openapi.json) solo se sirve desde localhost.
DOCS_LOCAL_ONLY=true
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# ─── Base de datos (la usa tanto Compose como la app) ───────────────
POSTGRES_USER=memories
POSTGRES_PASSWORD=cambiame_en_local
POSTGRES_DB=memories
POSTGRES_HOST_PORT=5433
# Fuera de Docker apunta a localhost; dentro de Compose la sobreescribe el servicio.
DATABASE_URL=postgresql+asyncpg://memories:cambiame_en_local@localhost:5433/memories

# ─── Redis ──────────────────────────────────────────────────────────
REDIS_PASSWORD=cambiame_en_local
REDIS_HOST_PORT=6380
REDIS_URL=redis://:cambiame_en_local@localhost:6380/0

# ─── Seguridad ──────────────────────────────────────────────────────
# Generala con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=cambiame_por_una_clave_larga_y_aleatoria
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Algoritmo de hashing de contrasenas: bcrypt | argon2 (RNF-08).
# Se puede cambiar en caliente: las contrasenas antiguas se re-hashean solas
# en el siguiente inicio de sesion.
PASSWORD_HASHING_SCHEME=bcrypt
BCRYPT_ROUNDS=12
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_DEFAULT_PER_MINUTE=120

# ─── Almacenamiento de fotografias (RNF-09) ─────────────────────────
# minio -> local (Docker Compose) | s3 -> AWS S3 | local -> disco (solo tests)
STORAGE_PROVIDER=minio
S3_BUCKET=memories-photos
S3_REGION=us-east-1
# MinIO local:
S3_ENDPOINT_URL=http://localhost:9010
S3_PUBLIC_ENDPOINT=http://localhost:9010
S3_ACCESS_KEY=memories_minio
S3_SECRET_KEY=cambiame_en_local
S3_USE_SSL=false
S3_PRESIGNED_URL_TTL_SECONDS=900
# Credenciales de MinIO para Docker Compose (deben coincidir con S3_ACCESS_KEY/SECRET)
MINIO_ROOT_USER=memories_minio
MINIO_ROOT_PASSWORD=cambiame_en_local
MINIO_API_PORT=9010
MINIO_CONSOLE_PORT=9011
# Solo para STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./storage

# ─── Reglas de producto (ver PRD, Anexo A) ──────────────────────────
MAX_PHOTOS_PER_MEMORY=10
MAX_PHOTO_SIZE_MB=15
ALLOWED_IMAGE_CONTENT_TYPES=image/jpeg,image/png,image/webp

# ─── Cache ──────────────────────────────────────────────────────────
# redis en ejecucion normal; memory en tests
CACHE_PROVIDER=redis

# ─── Puertos publicados en tu maquina ───────────────────────────────
# Se eligen distintos de los habituales a proposito: asi este entorno
# convive con otros proyectos (CRIS ocupa 5432, 6379, 9000 y 8000).
# Dentro de Docker los servicios se siguen llamando por su nombre y usan
# sus puertos estandar; esto solo afecta a como los ves desde el host.
API_HOST_PORT=8001
ADMINER_HOST_PORT=8081
