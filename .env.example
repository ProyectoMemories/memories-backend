# ═══════════════════════════════════════════════════════════════════════
# Memories — variables de entorno para desarrollo local
# Copia este archivo a .env y cambia las contraseñas. El .env NUNCA se sube.
# ═══════════════════════════════════════════════════════════════════════

# ─── API ────────────────────────────────────────────────────────────────
# Puerto de la API en tu PC: http://localhost:8001
API_HOST_PORT=8001
# Único origen al que CORS deja llamar a la API: el de la app web. Corre
# Flutter web en este puerto: flutter run -d chrome --web-port 3000
# Sin '/' al final y nunca '*'.
WEB_APP_ORIGIN=http://localhost:3000

# ─── PostgreSQL 18 ──────────────────────────────────────────────────────
POSTGRES_USER=memories
POSTGRES_PASSWORD=cambiame
POSTGRES_DB=memories
# Puerto en tu PC. 5433 para no chocar con otro PostgreSQL que ya tengas.
POSTGRES_HOST_PORT=5433

# ─── MinIO (almacenamiento S3 de las fotos) ─────────────────────────────
# Usuario de al menos 3 caracteres y contraseña de al menos 8.
# Solo letras y números: van dentro de una URL en docker-compose.yml.
MINIO_ROOT_USER=memories
MINIO_ROOT_PASSWORD=cambiame123
S3_BUCKET=memories-photos
# API S3 y consola web en tu PC.
MINIO_API_HOST_PORT=9010
MINIO_CONSOLE_HOST_PORT=9011

# ─── Mailpit (correos de desarrollo) ────────────────────────────────────
MAILPIT_SMTP_HOST_PORT=1025
MAILPIT_UI_HOST_PORT=8025
